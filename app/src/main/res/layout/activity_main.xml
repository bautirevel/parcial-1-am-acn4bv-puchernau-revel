<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        android:padding="@dimen/spacing_medium"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/colorTextOnPrimary"
            android:textSize="@dimen/text_size_subtitle"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_llamar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_phone"
            android:textColor="@color/colorTextOnPrimary"
            android:textSize="@dimen/text_size_body" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_principal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contenedor_scrollable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium">

            <ImageView
                android:id="@+id/imagen_hero"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_image_height"
                android:contentDescription="@string/hero_imagen_desc"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/hero_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/hero_title"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hero_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:lineSpacingExtra="4sp"
                android:text="@string/hero_desc"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_size_body" />

            <Button
                android:id="@+id/boton_ver_servicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/btn_ver_servicios" />

            <LinearLayout
                android:id="@+id/botonera_secundaria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_small">

                <Button
                    android:id="@+id/boton_pedir_turno"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:text="@string/btn_pedir_turno" />

                <Button
                    android:id="@+id/boton_galeria"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_galeria" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_mis_turnos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_large"
                android:background="@drawable/bg_card"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/titulo_mis_turnos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_mis_turnos"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="@dimen/text_size_subtitle"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/texto_resumen_turnos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/resumen_turnos_vacio"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
